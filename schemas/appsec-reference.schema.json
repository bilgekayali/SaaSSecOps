{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bilgekayali/SaaSSecOps/schemas/appsec-reference.schema.json",
  "title": "SaaSSecOps Application and API Security Reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reference_version", "is_reference_only", "standards", "secure_sdlc", "edge_and_api", "secrets", "supply_chain", "controls", "non_claims"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "reference_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "is_reference_only": {"const": true},
    "standards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owasp_top10", "owasp_api_security_top10"],
      "properties": {
        "owasp_top10": {"$ref": "#/$defs/standardList2025"},
        "owasp_api_security_top10": {"$ref": "#/$defs/standardList2023"}
      }
    },
    "secure_sdlc": {"$ref": "#/$defs/booleanControlMap"},
    "edge_and_api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["managed_ingress_required", "waf_reference_control", "tls_minimum", "rate_limiting_required", "request_limits_required", "object_authorization_required", "function_authorization_required", "request_schema_validation_required", "api_inventory_required", "outbound_api_trust_review_required"],
      "properties": {
        "managed_ingress_required": {"const": true},
        "waf_reference_control": {"const": true},
        "tls_minimum": {"enum": ["1.2", "1.3"]},
        "rate_limiting_required": {"const": true},
        "request_limits_required": {"const": true},
        "object_authorization_required": {"const": true},
        "function_authorization_required": {"const": true},
        "request_schema_validation_required": {"const": true},
        "api_inventory_required": {"const": true},
        "outbound_api_trust_review_required": {"const": true}
      }
    },
    "secrets": {"$ref": "#/$defs/booleanControlMap"},
    "supply_chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cyclonedx_version", "codeql_gate", "dependency_audit_gate", "sbom_generation_gate"],
      "properties": {
        "cyclonedx_version": {"const": "1.7"},
        "codeql_gate": {"const": true},
        "dependency_audit_gate": {"const": true},
        "sbom_generation_gate": {"const": true}
      }
    },
    "controls": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "objective", "maps_to"],
        "properties": {
          "id": {"pattern": "^APP-[0-9]{2}$", "type": "string"},
          "objective": {"type": "string", "minLength": 1},
          "maps_to": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "non_claims": {"type": "array", "minItems": 5, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "standardList2025": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "risks"],
      "properties": {
        "version": {"const": "2025"},
        "risks": {"type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "pattern": "^A(0[1-9]|10):2025 "}}
      }
    },
    "standardList2023": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "risks"],
      "properties": {
        "version": {"const": "2023"},
        "risks": {"type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "pattern": "^API(0?[1-9]|10):2023 "}}
      }
    },
    "booleanControlMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"const": true}
    }
  }
}
